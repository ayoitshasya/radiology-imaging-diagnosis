# Copy to .env and fill in real values. Never commit .env.

# Kaggle API (dataset downloads)
KAGGLE_API_TOKEN=

# PostgreSQL (docker compose service). POSTGRES_PORT is the HOST port; 5433 avoids a
# clash with a natively installed Postgres on 5432. Keep DATABASE_URL's port in step.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=radiology
POSTGRES_USER=radiology
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://radiology:CHANGE_ME@localhost:5433/radiology

# Orthanc DICOM server
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

# Backend. API_PORT is the HOST port the API is published on (127.0.0.1 only) by
# docker compose; inside the compose network the backend reaches Postgres and Orthanc by
# service name, so DATABASE_URL and ORTHANC_URL above are only for running on the host.
# POSTGRES_PASSWORD must be URL-safe (no @ : / ? #): compose puts it into a database URL.
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (docker compose build argument). The API address as the browser on the host
# sees it, so it must use API_PORT. Built into the page: never a secret. The viewer is
# always published on http://localhost:5173, the only origin the API's CORS allows.
VITE_API_BASE_URL=http://127.0.0.1:8000
