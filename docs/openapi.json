          "prediction_id",
          "decision",
          "reviewer",
          "created_at"
        ],
        "title": "ReviewSummary",
        "description": "Latest review decision, shown next to a prediction."
      },
      "StudyList": {
        "properties": {
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "Educational use only. Not for clinical use."
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "studies": {
            "items": {
              "$ref": "#/components/schemas/StudyStatus"
            },
            "type": "array",
            "title": "Studies"
          }
        },
        "type": "object",
        "required": [
          "count",
          "studies"
        ],
        "title": "StudyList",
        "description": "GET /studies."
      },
      "StudyStatus": {
        "properties": {
          "orthanc_study_id": {
            "type": "string",
            "title": "Orthanc Study Id"
          },
          "study_instance_uid": {
            "type": "string",
            "title": "Study Instance Uid"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_synced",
              "pending",
              "analysed"
            ],
            "title": "Status"
          },
          "latest_prediction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PredictionSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "latest_review": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReviewSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "orthanc_study_id",
          "study_instance_uid",
          "status"
        ],
        "title": "StudyStatus",
        "description": "One Orthanc study and where it is in the workflow."
      },
      "SyncResult": {
        "properties": {
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "Educational use only. Not for clinical use."
          },
          "orthanc_studies": {
            "type": "integer",
            "title": "Orthanc Studies"
          },
          "added": {
            "type": "integer",
            "title": "Added"
          },
          "already_synced": {
            "type": "integer",
            "title": "Already Synced"
          },
          "pending": {
            "type": "integer",
            "title": "Pending"
          },
          "missing_from_orthanc": {
            "type": "integer",
            "title": "Missing From Orthanc"
          }
        },
        "type": "object",
        "required": [
          "orthanc_studies",
          "added",
          "already_synced",
          "pending",
          "missing_from_orthanc"
        ],
        "title": "SyncResult",
        "description": "POST /studies/sync."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
