            "type": "integer",
            "title": "Review Id"
          },
          "prediction_id": {
            "type": "integer",
            "title": "Prediction Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "Decision"
          },
