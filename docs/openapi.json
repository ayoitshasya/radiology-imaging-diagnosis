        "properties": {
          "prediction_id": {
            "type": "integer",
            "title": "Prediction Id"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "label": {
            "type": "integer",
            "title": "Label"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
