{
  "openapi": "3.1.0",
  "info": {
    "title": "Radiology imaging diagnosis API",
    "description": "Educational use only. Not for clinical use.",
    "version": "0.1.0"
  },
  "paths": {
    "/studies": {
      "get": {
        "tags": [
          "studies"
        ],
        "summary": "List Studies",
        "description": "List every study in Orthanc with its status: not_synced, pending or analysed.",
        "operationId": "list_studies_studies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyList"
                }
              }
            }
          }
        }
      }
    },
    "/studies/sync": {
      "post": {
        "tags": [
          "studies"
        ],
        "summary": "Sync Studies",
        "description": "Register Orthanc studies the database does not know yet; they start as pending.\n\nList-and-diff rather than Orthanc's changes feed: one request lists all studies, the\ndiff is stateless and idempotent, and no cursor has to be stored. The cost is linear\nin the number of studies, which is fine at demo scale. ON CONFLICT DO NOTHING keeps\nconcurrent syncs from creating duplicates. Studies gone from Orthanc are counted,\nnever deleted.",
        "operationId": "sync_studies_studies_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              }
            }
          }
        }
      }
    },
    "/studies/{orthanc_study_id}/analyse": {
      "post": {
        "tags": [
          "studies"
        ],
        "summary": "Analyse Study",
        "description": "Run the model and Grad-CAM on a synced study and store the prediction.\n\nIdempotent: if the study already has a prediction and force is false, the stored\nresult is returned (cached=true). An audit event is written either way. With force,\na new prediction row is added; earlier rows are never changed.",
        "operationId": "analyse_study_studies__orthanc_study_id__analyse_post",
        "parameters": [
          {
            "name": "orthanc_study_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b",
              "title": "Orthanc Study Id"
            },
            "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b"
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Re-run even if a prediction exists",
              "default": false,
              "title": "Force"
            },
            "description": "Re-run even if a prediction exists"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/studies/{orthanc_study_id}/result": {
      "get": {
        "tags": [
          "studies"
        ],
        "summary": "Study Result",
        "description": "The latest stored prediction for a study; 404 if the study is unknown or unanalysed.",
        "operationId": "study_result_studies__orthanc_study_id__result_get",
        "parameters": [
          {
            "name": "orthanc_study_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b",
              "title": "Orthanc Study Id"
            },
            "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/studies/{orthanc_study_id}/image": {
      "get": {
        "tags": [
          "studies"
        ],
        "summary": "Study Image",
        "description": "The preprocessed image the model sees (224x224 grayscale PNG), built in memory.",
        "operationId": "study_image_studies__orthanc_study_id__image_get",
        "parameters": [
          {
            "name": "orthanc_study_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b",
              "title": "Orthanc Study Id"
            },
            "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/studies/{orthanc_study_id}/heatmap": {
      "get": {
        "tags": [
          "studies"
        ],
        "summary": "Study Heatmap",
        "description": "Grad-CAM overlay PNG for the study's latest prediction.\n\nServed from the in-memory cache, or recomputed after eviction or a restart. A\nrecomputed heatmap must explain the same model that made the prediction, so a\ncheckpoint mismatch is refused (409) instead of silently explaining another model.",
        "operationId": "study_heatmap_studies__orthanc_study_id__heatmap_get",
        "parameters": [
          {
            "name": "orthanc_study_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b",
              "title": "Orthanc Study Id"
            },
            "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/studies/{orthanc_study_id}/review": {
      "post": {
        "tags": [
          "reviews"
        ],
        "summary": "Review Study",
        "description": "Record approved or rejected for the study's latest prediction. A reason is required for a rejection. Each call adds a new review; none is edited. Do not type patient names, patient IDs, dates of birth or any other patient identifier into this field.",
        "operationId": "review_study_studies__orthanc_study_id__review_post",
        "parameters": [
          {
            "name": "orthanc_study_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b",
              "title": "Orthanc Study Id"
            },
            "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/studies/{orthanc_study_id}/reviews": {
      "get": {
        "tags": [
          "reviews"
        ],
        "summary": "Study Reviews",
        "description": "Every review of the study's predictions, oldest first; empty if none yet.",
        "operationId": "study_reviews_studies__orthanc_study_id__reviews_get",
        "parameters": [
          {
            "name": "orthanc_study_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$",
              "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b",
              "title": "Orthanc Study Id"
            },
            "description": "Orthanc study ID, e.g. 29aa9e33-a3c9c0ba-d412334d-8decdd60-7eedb09b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewHistory"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "List Audit",
        "description": "Audit events filtered by study, type and time range; newest first, paginated.\n\nOrdered by created_at then id, so events with the same timestamp keep a stable order\nacross pages. ``total`` counts all events matching the filters.",
        "operationId": "list_audit_audit_get",
        "parameters": [
          {
            "name": "study_instance_uid",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9.]+$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "DICOM StudyInstanceUID",
              "title": "Study Instance Uid"
            },
            "description": "DICOM StudyInstanceUID"
          },
          {
            "name": "event_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "study_synced",
                    "analysis_completed",
                    "analysis_returned_cached",
                    "review_submitted"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Event Type"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO 8601; inclusive; UTC if no timezone",
              "title": "Since"
            },
            "description": "ISO 8601; inclusive; UTC if no timezone"
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO 8601; exclusive; UTC if no timezone",
              "title": "Until"
            },
            "description": "ISO 8601; exclusive; UTC if no timezone"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Report whether Orthanc, the database and the model are usable (200) or not (503).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEntry": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "study_instance_uid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
