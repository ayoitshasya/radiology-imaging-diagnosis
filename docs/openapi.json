          },
          "prediction_id": {
            "type": "integer",
            "title": "Prediction Id"
          },
          "orthanc_study_id": {
            "type": "string",
            "title": "Orthanc Study Id"
          },
          "study_instance_uid": {
            "type": "string",
            "title": "Study Instance Uid"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "label": {
            "type": "integer",
            "title": "Label"
          },
          "label_meaning": {
            "type": "string",
            "title": "Label Meaning",
            "default": "1 = model score at or above the validation-chosen threshold (pneumonia opacity predicted); 0 = below it. A model output, not a diagnosis."
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "threshold_source": {
            "type": "string",
            "title": "Threshold Source",
