# Local environment backup (never commit)
system_packages_backup.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.venv/
venv/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.next/
frontend/dist/

# Data and models (tracked with DVC, not git)
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/**/*.dvc
# Weights stay out of git; only their DVC pointer files are tracked.
# `?*` rather than `*`: for git both mean every entry inside models/, but DVC's ignore
# matcher also lets `*` match the empty name, treats the models/ folder itself as ignored,
# skips the pointer, and a bare `dvc pull` or `dvc push` then misses the weights.
/models/?*
!/models/*.dvc
# Archives such as downloaded Kaggle results bundles
*.zip
# Smoke-test outputs are pipeline checks, never results
/reports/smoke/
*.pt
*.pth
*.ckpt
*.onnx
*.nii
*.nii.gz
*.dcm

# Secrets
.env
.env.*
!.env.example
kaggle.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
